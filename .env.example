# Copy to .env and fill in your keys.
# Multi-key rotation is automatically enabled if multiple keys are provided.
# You can provide multiple keys in either of two ways:
#
# Option A: Comma-separated (e.g., 3 keys per provider)
# GROQ_API_KEY=gsk_key1...,gsk_key2...,gsk_key3...
# GEMINI_API_KEY=AIzaSy1...,AIzaSy2...,AIzaSy3...
#
# Option B: Numbered variables
# GROQ_API_KEY=gsk_key1...
# GROQ_API_KEY_2=gsk_key2...
# GROQ_API_KEY_3=gsk_key3...
# GEMINI_API_KEY=AIzaSy1...
# GEMINI_API_KEY_2=AIzaSy2...
# GEMINI_API_KEY_3=AIzaSy3...

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
